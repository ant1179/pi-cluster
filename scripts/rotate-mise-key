#!/usr/bin/env bash

set -euo pipefail

# Prérequis
# - Le script est exécuté depuis le devcontainer.
# - La clé Age à remplacer est stockée dans CURRENT_KEY_FILE.
# - Mise utilise la clé stockée dans SOPS_AGE_KEY_FILE.

# 0. Définir les chemins
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT_PATH="$(cd "$SCRIPT_DIR/.." && pwd)"

export SOPS_AGE_KEY_FILE="$HOME/.config/mise/age.txt"

CURRENT_KEY_FILE="$APP_ROOT_PATH/age-devcontainer.txt"
SOPS_OLD_KEY_FILE="$HOME/.config/mise/age.old.txt"
CURRENT_KEY_FILE_OLD="$APP_ROOT_PATH/age-devcontainer.old.txt"
TEMP_KEY_FILE="$APP_ROOT_PATH/age-devcontainer.new.txt"
ENCRYPTED_FILE="$APP_ROOT_PATH/.env.json"

# 1. Vérifications préalables
[[ -f "$SOPS_AGE_KEY_FILE" ]] || {
    echo "Erreur : clé Mise introuvable : $SOPS_AGE_KEY_FILE"
    exit 1
}

[[ -f "$CURRENT_KEY_FILE" ]] || {
    echo "Erreur : clé courante introuvable : $CURRENT_KEY_FILE"
    exit 1
}

[[ -f "$ENCRYPTED_FILE" ]] || {
    echo "Erreur : fichier SOPS introuvable : $ENCRYPTED_FILE"
    exit 1
}

[[ ! -e "$TEMP_KEY_FILE" ]] || {
    echo "Erreur : le fichier temporaire existe déjà : $TEMP_KEY_FILE"
    exit 1
}

# 2. Créer un fichier temporaire pour le contenu déchiffré
PLAINTEXT_FILE="$(mktemp)"
chmod 600 "$PLAINTEXT_FILE"

cleanup() {
    rm -f "$PLAINTEXT_FILE"
}

trap cleanup EXIT

# 3. Déchiffrer sans modifier .env.json
sops -d "$ENCRYPTED_FILE" > "$PLAINTEXT_FILE"

# 4. Sauvegarder les anciennes clés
cp -v "$SOPS_AGE_KEY_FILE" "$SOPS_OLD_KEY_FILE"
chmod 600 "$SOPS_OLD_KEY_FILE"

cp -v "$CURRENT_KEY_FILE" "$CURRENT_KEY_FILE_OLD"
chmod 600 "$CURRENT_KEY_FILE_OLD"

# 5. Générer la nouvelle clé
age-keygen -o "$TEMP_KEY_FILE"
chmod 600 "$TEMP_KEY_FILE"

# 6. Récupérer sa clé publique
AGE_PUBLIC="$(age-keygen -y "$TEMP_KEY_FILE")"
echo "AGE_PUBLIC: $AGE_PUBLIC"

# 7. Installer temporairement la nouvelle clé à l'emplacement utilisé par Mise
cp -v "$TEMP_KEY_FILE" "$SOPS_AGE_KEY_FILE"
chmod 600 "$SOPS_AGE_KEY_FILE"

# 8. Rechiffrer .env.json avec la nouvelle clé
sops \
    --age="$AGE_PUBLIC" \
    -e "$PLAINTEXT_FILE" > "$ENCRYPTED_FILE"

# 9. Vérifier que la nouvelle clé déchiffre réellement le fichier
SOPS_AGE_KEY_FILE="$SOPS_AGE_KEY_FILE" \
    sops -d "$ENCRYPTED_FILE" >/dev/null

echo "New key OK"

# 10. Installer la nouvelle clé
cp -v "$TEMP_KEY_FILE" "$CURRENT_KEY_FILE"
cp -v "$TEMP_KEY_FILE" "$SOPS_AGE_KEY_FILE"

chmod 600 "$CURRENT_KEY_FILE" "$SOPS_AGE_KEY_FILE"

# 11. Revenir au comportement normal de Mise
unset MISE_SOPS_AGE_KEY_FILE

# SOPS_AGE_KEY_FILE pointe déjà vers ~/.config/mise/age.txt,
# qui contient maintenant la nouvelle clé.
mise env >/dev/null

echo "Mise OK"

# 12. Supprimer les anciennes clés après validation
rm -f "$SOPS_OLD_KEY_FILE"
rm -f "$CURRENT_KEY_FILE_OLD"
rm -f "$TEMP_KEY_FILE"

echo "Rotation de la clé Age terminée avec succès."
echo "Étape suivante : reconstruire complètement le devcontainer."

